{
  "version": 1,
  "introducedIn": "v60",
  "gameId": "fishing",
  "feature": "big_fish_fight",
  "goal": "通常魚の短いテンポを維持しつつ、大物だけアワセ後に追加の操作と緊張感を持たせる。",
  "flow": [
    "cast",
    "wait",
    "bite",
