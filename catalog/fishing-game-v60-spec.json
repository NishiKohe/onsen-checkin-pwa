    "SR": "60%",
    "SSR": "100%",
    "LEGEND": "100%",
    "debugForced": "100%"
  },
  "fightRules": {
    "input": "巻くボタン長押し",
    "tensionSafeRange": [0.28, 0.78],
    "lineBreakAt": 1.0,
    "slackEscapeBelow": 0.07,
    "slackEscapeSeconds": 0.9,
    "maxFightSeconds": 24,
