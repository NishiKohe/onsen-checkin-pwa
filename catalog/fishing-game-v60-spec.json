  "reward": {
    "SRFightMultiplier": 1.15,
    "SSRFightMultiplier": 1.25,
    "LegendFightMultiplier": 1.4,
    "firstDiscoveryBonusYusen": 5
  },
  "debug": {
    "forceNextBigFish": "次のアワセ成功時にSR以上を選び、必ずファイトへ移行する",
    "refillTravelEnergy": true,
    "resetFishingProgress": true
  },
  "offline": true,
  "visitIntegrity": "ゲーム結果は訪問済み・GPS現地確認には影響しない"
